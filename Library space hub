	function api:CreateKeybind(o)
		local f = row(page, 40, nextOrder())
		makeLabel(f, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.5, -12, 1, 0), Text = o.Name, Font = Enum.Font.GothamMedium, TextSize = 14 })
		local obj = { Type = "Keybind", CurrentKeybind = o.CurrentKeybind or "None", Name = o.Name }
		local btn = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(96, 26),
			BackgroundColor3 = C(20, 22, 28), AutoButtonColor = false, Text = obj.CurrentKeybind,
			Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = TEXT,
		}, f)
		corner(btn, 6)
		metalStroke(btn, 1.5)
		local listening = false
		local function setKey(name, silent)
			obj.CurrentKeybind = name
			btn.Text = name
			if not silent then
				if o.OnSet then
					pcall(o.OnSet, name)
				end
				autosave()
			end
		end
		btn.Activated:Connect(function()
			listening = true
			SpaceHub._listening = true
			btn.Text = "..."
		end)
		bind(UserInputService.InputBegan, function(input, gp)
			if listening then
				if input.UserInputType == Enum.UserInputType.Keyboard then
					listening = false
					task.defer(function()
						SpaceHub._listening = false
					end)
					if input.KeyCode == Enum.KeyCode.Escape then
						btn.Text = obj.CurrentKeybind
					else
						setKey(input.KeyCode.Name)
					end
				end
				return
			end
			if gp or SpaceHub._listening then
				return
			end
			if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name == obj.CurrentKeybind then
				if o.HoldToInteract then
					safe(o.Callback, true)
				else
					safe(o.Callback, obj.CurrentKeybind)
				end
			end
		end)
		bind(UserInputService.InputEnded, function(input)
			if o.HoldToInteract and input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name == obj.CurrentKeybind then
				safe(o.Callback, false)
			end
		end)
		function obj:Set(name)
			setKey(tostring(name))
		end
		register(o.Name, "Keybind", f, tab)
		flag(o, obj)
		return obj
	end

