	-- ===== DRAGGING (header, pill and grab line) =====
	local drag
	local function startDrag(input, fromGrab, onlyMove)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			drag = {
				start = input.Position, last = input.Position,
				pos = Vector2.new(container.Position.X.Offset, container.Position.Y.Offset),
				moved = false, grab = fromGrab, time = os.clock(), move = onlyMove,
			}
		end
	end
	header.InputBegan:Connect(function(i)
		startDrag(i, false)
	end)
	grab.InputBegan:Connect(function(i)
		startDrag(i, true)
	end)
	btnMove.InputBegan:Connect(function(i)
		startDrag(i, false, true)
	end)

	bind(UserInputService.InputChanged, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if resizing then
			local d = input.Position - resizing.start
			W = math.clamp(resizing.w + d.X, math.min(SIZE.MinW, maxW()), maxW())
			H = math.clamp(resizing.h + d.Y, math.min(SIZE.MinH, maxH()), maxH())
			container.Size = UDim2.fromOffset(W, H)
			return
		end
		if not drag then
			return
		end
		local d = input.Position - drag.start
		if not drag.moved and d.Magnitude > 5 then
			drag.moved = true
			if drag.grab then
				barActive(true)
			end
		end
		if drag.moved then
			local p = limit(drag.pos.X + d.X, drag.pos.Y + d.Y, container.AbsoluteSize.X, container.AbsoluteSize.Y)
			tw(container, 0.08, { Position = UDim2.fromOffset(p.X, p.Y) }, Enum.EasingStyle.Linear)
			if drag.grab then
				local step = input.Position - drag.last
				drag.last = input.Position
				tw(bar, 0.08, {
					Position = UDim2.new(0.5, math.clamp(step.X * 2, -10, 10), 0.5, math.clamp(step.Y * 2, -4, 4)),
				}, Enum.EasingStyle.Linear)
			end
		end
	end)

	bind(UserInputService.InputEnded, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if resizing then
			resizing = nil
			tw(grip, 0.15, { TextColor3 = BAR_GRAY })
		end
		if drag then
			local d0 = drag
			drag = nil
			if d0.moved then
				if d0.grab then
					barActive(false)
				end
			elseif minimized and not d0.grab and not d0.move and os.clock() - d0.time <= 0.35 and (input.Position - d0.start).Magnitude <= 8 then
				setMinimized(false)
			end
		end
	end)

	-- ===== SHOW / HIDE (toggle key + mobile button) =====
	local hidden = false
	local showBtn = new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.fromOffset(160, 34),
		AutoButtonColor = false, Text = "Show " .. menuName, Font = Enum.Font.GothamMedium, TextSize = 13,
		TextColor3 = TEXT, Visible = false, ZIndex = 30,
	}, gui)
	themed(showBtn, "BackgroundColor3", "Background")
	corner(showBtn, 17)
	metalStroke(showBtn, 1.5)
	local mobile = settings.MobileButton
	if mobile == nil then
		mobile = UserInputService.TouchEnabled
	end

	function Window:Hide()
		if hidden then
			return
		end
		hidden = true
		tw(frame, 0.3, { GroupTransparency = 1 })
		for _, s in ipairs(shadows) do
			tw(s.f, 0.3, { BackgroundTransparency = 1 })
		end
		task.delay(0.32, function()
			if hidden then
				container.Visible = false
			end
		end)
		showBtn.Visible = mobile
	end
	function Window:Show()
		if not hidden then
			return
		end
		hidden = false
		container.Visible = true
		showBtn.Visible = false
		tw(frame, 0.3, { GroupTransparency = 0 })
		for _, s in ipairs(shadows) do
			tw(s.f, 0.3, { BackgroundTransparency = s.final })
		end
	end
	function Window:Toggle()
		if hidden then
			Window:Show()
		else
			Window:Hide()
		end
	end
	showBtn.Activated:Connect(function()
		Window:Show()
	end)
	bind(UserInputService.InputBegan, function(input, gp)
		if gp or SpaceHub._listening then
			return
		end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end)

	--// Public window API
	function Window:Notify(o)
		SpaceHub:Notify(o)
	end
	function Window:Minimize(v)
		setMinimized(v ~= false)
	end
	function Window:SetTheme(name)
		return setThemeByName(name)
	end
	function Window:SetToggleKey(key)
		toggleKey = key
	end
	function Window:SetMenuType(m)
		applyMode(m == "horizontal" and "horizontal" or "vertical")
	end
	function Window:Destroy()
		SpaceHub:Destroy()
	end

	-- ===== START =====
	applyMode("vertical")
	tw(frame, 0.4, { GroupTransparency = 0 }, Enum.EasingStyle.Sine)
	for _, s in ipairs(shadows) do
		tw(s.f, 0.4, { BackgroundTransparency = s.final })
	end

	self._window = Window
	task.spawn(function()
		pcall(discordPrompt, settings.Discord)
	end)
	return Window
end

--// ===================== DESTROY =====================
function SpaceHub:Destroy()
	for _, c in ipairs(connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(connections)
	for _, g in ipairs(allGuis) do
		pcall(function()
			g:Destroy()
		end)
	end
	table.clear(allGuis)
	table.clear(themeRegistry)
	table.clear(themeHooks)
	notifGui, notifHolder = nil, nil
	self._window = nil
	self.Flags = {}
end

return SpaceHub
