		}, sv)
		corner(svKnob, UDim.new(1, 0))
		new("UIStroke", { Thickness = 2, Color = WHITE }, svKnob)

		local hue = new("Frame", {
			Position = UDim2.new(1, -44, 0, 10), Size = UDim2.fromOffset(30, 136), BackgroundColor3 = WHITE, BorderSizePixel = 0,
		}, ex.Body)
		corner(hue, 6)
		new("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, C(255, 0, 0)), ColorSequenceKeypoint.new(0.17, C(255, 255, 0)),
				ColorSequenceKeypoint.new(0.33, C(0, 255, 0)), ColorSequenceKeypoint.new(0.5, C(0, 255, 255)),
				ColorSequenceKeypoint.new(0.67, C(0, 0, 255)), ColorSequenceKeypoint.new(0.83, C(255, 0, 255)),
				ColorSequenceKeypoint.new(1, C(255, 0, 0)),
			}),
		}, hue)
		local hueKnob = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 6, 0, 6), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3,
		}, hue)
		corner(hueKnob, 3)
		new("UIStroke", { Thickness = 1, Color = Color3.new(0, 0, 0) }, hueKnob)

		local obj = { Type = "ColorPicker", Color = color, Name = o.Name }
		local function refresh(fire)
			color = Color3.fromHSV(h, s, v)
			obj.Color = color
			swatch.BackgroundColor3 = color
			sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
			hueKnob.Position = UDim2.new(0.5, 0, h, 0)
			if fire then
				safe(o.Callback, color)
				autosave()
			end
		end
		refresh(false)

		local mode
		local function drag(pos)
			if mode == "sv" then
				s = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
				v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
			elseif mode == "hue" then
				h = math.clamp((pos.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 1)
			else
				return
			end
			refresh(true)
		end
		local function start(m)
			return function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					mode = m
					page.ScrollingEnabled = false
					drag(screenPos(input))
				end
			end
		end
		sv.InputBegan:Connect(start("sv"))
		hue.InputBegan:Connect(start("hue"))
		bind(UserInputService.InputChanged, function(input)
			if mode and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				drag(screenPos(input))
			end
		end)
		bind(UserInputService.InputEnded, function(input)
			if mode and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				mode = nil
				page.ScrollingEnabled = true
			end
		end)
		function obj:Set(c)
			h, s, v = c:ToHSV()
			refresh(true)
		end
		register(o.Name, "ColorPicker", ex.Head, tab)
		flag(o, obj)
		return obj
	end
	-- ============================================================
	-- PEGA ESTE BLOQUE en la libreria, dentro de makeApi(), justo
	-- ANTES de la linea:   return api
	-- (despues de api:CreateColorPicker)
	-- ============================================================

	-- Code block (marco de codigo con scroll y boton Copy)
	function api:CreateCodeBlock(o)
		local height = o.Height or 240
		local f = row(page, height, nextOrder())
		makeLabel(f, {
			Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -110, 0, 34),
			Text = o.Title or "Code", Font = Enum.Font.GothamMedium, TextSize = 13,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		local copyFrame, copyBtn = makeButton(f, "Copy", 1, 24)
		copyFrame.AnchorPoint = Vector2.new(1, 0)
		copyFrame.Position = UDim2.new(1, -8, 0, 5)
		copyFrame.Size = UDim2.fromOffset(78, 24)
		copyBtn.TextSize = 12

		local box = new("Frame", {
			Position = UDim2.fromOffset(8, 34), Size = UDim2.new(1, -16, 1, -42),
			BackgroundColor3 = C(14, 16, 22), BorderSizePixel = 0,
		}, f)
		corner(box, 6)
		metalStroke(box, 1)
		local scroll = new("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.XY,
			ScrollingDirection = Enum.ScrollingDirection.XY,
		}, box)
		themed(scroll, "ScrollBarImageColor3", "Accent")
		pad(scroll, 6, 8, 6, 8)
		local list = new("Frame", {
			Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1,
		}, scroll)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)

		local obj = { Type = "CodeBlock", CurrentValue = o.Code or "", Name = o.Title or "Code" }
		local function render(code)
			for _, c in ipairs(list:GetChildren()) do
				if c:IsA("TextLabel") then
					c:Destroy()
				end
			end
			-- Roblox limita un TextLabel a ~16000 caracteres: se reparte en bloques de 60 lineas
			local lines = string.split((tostring(code):gsub("\r", "")), "\n")
			local chunk, n, idx = {}, 0, 0
			local function flush()
				if #chunk == 0 then
					return
				end
				idx += 1
				new("TextLabel", {
					LayoutOrder = idx, Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY,
					BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 12, TextColor3 = TEXT,
					TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
					TextWrapped = false, RichText = false, Text = table.concat(chunk, "\n"),
				}, list)
				chunk, n = {}, 0
			end
			for _, line in ipairs(lines) do
				n += 1
				chunk[n] = (line:gsub("\t", "    "))
				if n >= 60 then
					flush()
				end
			end
			flush()
		end
		render(obj.CurrentValue)

		local busy = false
		copyBtn.Activated:Connect(function()
			if busy then
				return
			end
			busy = true
			local ok = copyText(obj.CurrentValue)
			copyBtn.Text = ok and "Copied!" or "Unavailable"
			copyBtn.TextColor3 = ok and GREEN or RED
			task.delay(1.2, function()
				copyBtn.Text = "Copy"
				copyBtn.TextColor3 = TEXT
				busy = false
			end)
		end)
		function obj:Set(code)
			obj.CurrentValue = tostring(code)
			render(obj.CurrentValue)
		end
		register(o.Title or "Code", "Label", f, tab)
		return obj
	end


	return api
end

