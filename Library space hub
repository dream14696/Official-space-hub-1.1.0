--// ===================== GUI CONTAINER =====================
local function guiParent()
	local ok, core = pcall(function()
		return game:GetService("CoreGui")
	end)
	if ok and core then
		local probe = Instance.new("Folder")
		local writable = pcall(function()
			probe.Parent = core
		end)
		probe:Destroy()
		if writable then
			return core
		end
	end
	return player:WaitForChild("PlayerGui")
end

local function keepOnTop(gui)
	local cont = gui.Parent
	local last = 0
	local con = cont.ChildAdded:Connect(function(child)
		if child ~= gui and child:IsA("ScreenGui") and os.clock() - last > 1 then
			last = os.clock()
			task.defer(function()
				if gui.Parent == cont then
					gui.Parent = nil
					gui.Parent = cont
				end
			end)
		end
	end)
	gui.Destroying:Connect(function()
		con:Disconnect()
	end)
end

local function createGui(name)
	local parent = guiParent()
	local old = parent:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local gui = new("ScreenGui", {
		Name = name, IgnoreGuiInset = true, ResetOnSpawn = false,
		DisplayOrder = 2147483647, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, parent)
	keepOnTop(gui)
	table.insert(allGuis, gui)
	return gui
end

--// ===================== NOTIFICATIONS =====================
local notifGui, notifHolder, notifCount = nil, nil, 0

function SpaceHub:Notify(o)
	o = o or {}
	task.spawn(function()
		if not (notifGui and notifGui.Parent) then
			notifGui = createGui("SpaceHubNotifications")
			notifHolder = new("Frame", {
				AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -14),
				Size = UDim2.new(0, 300, 1, -28), BackgroundTransparency = 1,
			}, notifGui)
			new("UIListLayout", {
				Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom,
			}, notifHolder)
		end
		notifCount += 1
		local wrap = new("Frame", {
			LayoutOrder = notifCount, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		}, notifHolder)
		local card = new("CanvasGroup", {
			Position = UDim2.new(1, 320, 0, 0), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.Background, BorderSizePixel = 0, Active = true,
		}, wrap)
		corner(card, 10)
		new("UIStroke", { Color = Theme.Line, Thickness = 1 }, card)
		pad(card, 12, 12, 12, 12)
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, card)

		local hasIcon = false
		if o.Image then
			local img = new("ImageLabel", { LayoutOrder = 1, Size = UDim2.fromOffset(28, 28), BackgroundTransparency = 1, ImageColor3 = WHITE }, card)
			hasIcon = applyIcon(img, o.Image)
			if not hasIcon then
				img:Destroy()
			end
		end
		local textWrap = new("Frame", {
			LayoutOrder = 2, Size = UDim2.new(1, hasIcon and -38 or 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		}, card)
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, textWrap)
		makeLabel(textWrap, {
			LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			Text = o.Title or "Notification", Font = Enum.Font.GothamBold, TextSize = 14, TextWrapped = true,
		})
		if o.Content and o.Content ~= "" then
			makeLabel(textWrap, {
				LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				Text = o.Content, TextSize = 12, TextColor3 = MUTED, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
			})
		end

		tw(card, 0.4, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
		local alive = true
		card.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				alive = false
			end
		end)
		local t0 = os.clock()
		while alive and wrap.Parent and os.clock() - t0 < (o.Duration or 5) do
			task.wait(0.1)
		end
		if wrap.Parent then
			tw(card, 0.35, { Position = UDim2.new(1, 320, 0, 0), GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.wait(0.4)
			wrap:Destroy()
		end
	end)
end

--// ===================== CONFIGURATION SAVING =====================
local function configPath()
	local cs = (SpaceHub._settings and SpaceHub._settings.ConfigurationSaving) or {}
	local folder = cs.FolderName or "SpaceHub"
	return folder, folder .. "/" .. (cs.FileName or "config") .. ".json"
end

function SpaceHub:SaveConfiguration()
	if not canFile() then
		return false
	end
	local data = {}
	for flag, el in pairs(self.Flags) do
		local t = el.Type
		if t == "ColorPicker" then
			local c = el.Color
			data[flag] = { R = c.R, G = c.G, B = c.B }
		elseif t == "Dropdown" then
			data[flag] = el.CurrentOption
		elseif t == "Keybind" then
			data[flag] = el.CurrentKeybind
		else
			data[flag] = el.CurrentValue
		end
	end
	local folder, path = configPath()
	local ok = pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(folder) then
			makefolder(folder)
		end
		writefile(path, HttpService:JSONEncode(data))
	end)
	return ok
end

function SpaceHub:LoadConfiguration()
	if not canFile() then
		return false
	end
	local _, path = configPath()
	local okFile, exists = pcall(isfile, path)
	if not okFile or not exists then
		return false
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		return false
	end
	for flag, value in pairs(data) do
		local el = self.Flags[flag]
		if el then
			pcall(function()
				if el.Type == "ColorPicker" then
					el:Set(Color3.new(value.R, value.G, value.B))
				else
					el:Set(value)
				end
			end)
		end
	end
	return true
end

