local RED_A, RED_B = C(205, 60, 60), C(140, 32, 40)
local GRAY_A, GRAY_B = C(92, 95, 106), C(60, 62, 72)

local function runKeySystem(settings)
	local ks = settings.KeySettings or {}
	local keys = ks.Key or {}
	if type(keys) == "string" then
		keys = { keys }
	end
	local valid = {}
	for _, k in ipairs(keys) do
		if ks.GrabKeyFromSite then
			local ok, res = pcall(function()
				return game:HttpGet(k)
			end)
			if ok and type(res) == "string" then
				table.insert(valid, (res:gsub("%s", "")))
			end
		else
			table.insert(valid, tostring(k))
		end
	end
	local function check(txt)
		txt = (tostring(txt or ""):gsub("^%s+", ""):gsub("%s+$", ""))
		for _, k in ipairs(valid) do
			if txt == k then
				return true
			end
		end
		return false
	end

	local folder = (settings.ConfigurationSaving and settings.ConfigurationSaving.FolderName) or "SpaceHub"
	local path = folder .. "/" .. (ks.FileName or "Key") .. ".txt"
	if ks.SaveKey ~= false and canFile() then
		local ok, saved = pcall(function()
			return isfile(path) and readfile(path) or nil
		end)
		if ok and saved and check(saved) then
			return true
		end
	end

	local gui = createGui("SpaceHubKey")
	local modal = makeModal(gui, 360)
	local card = modal.Card
	modalText(card, 1, ks.Title or "Key System", 17, TEXT, Enum.Font.GothamBold)
	if ks.Subtitle then
		modalText(card, 2, ks.Subtitle, 13, MUTED)
	end
	if ks.Note then
		modalText(card, 3, ks.Note, 12, MUTED)
	end
	local boxFrame = new("Frame", { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = C(20, 22, 28), BorderSizePixel = 0 }, card)
	corner(boxFrame, 8)
	metalStroke(boxFrame, 1.5)
	local box = new("TextBox", {
		Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), BackgroundTransparency = 1, ClearTextOnFocus = false,
		PlaceholderText = "Enter key...", PlaceholderColor3 = MUTED, Text = "", Font = Enum.Font.Gotham,
		TextSize = 14, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left,
	}, boxFrame)
	local msg = modalText(card, 5, "", 12, RED)
	local defs = { { Text = "Submit" }, { Text = "Cancel", C1 = GRAY_A, C2 = GRAY_B } }
	if ks.KeyLink then
		table.insert(defs, 2, { Text = "Get key" })
	end
	local buttons = buttonRow(card, 6, defs)

	local result
	local function submit()
		if check(box.Text) then
			if ks.SaveKey ~= false and canFile() then
				pcall(function()
					if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(folder) then
						makefolder(folder)
					end
					writefile(path, box.Text)
				end)
			end
			result = true
		else
			msg.Text = "Invalid key. Try again."
			for i = 1, 6 do
				card.Position = UDim2.new(0.5, (i % 2 == 0) and 8 or -8, 0.5, 0)
				task.wait(0.04)
			end
			card.Position = UDim2.fromScale(0.5, 0.5)
		end
	end
	buttons[1].Activated:Connect(submit)
	box.FocusLost:Connect(function(enter)
		if enter then
			submit()
		end
	end)
	if ks.KeyLink then
		buttons[2].Activated:Connect(function()
			msg.Text = copyText(ks.KeyLink) and "Link copied to clipboard." or ks.KeyLink
			msg.TextColor3 = MUTED
		end)
	end
	buttons[#buttons].Activated:Connect(function()
		result = false
	end)
	repeat
		task.wait(0.1)
	until result ~= nil

	local closed = false
	modal.Close(function()
		closed = true
	end)
	repeat
		task.wait(0.05)
	until closed
	gui:Destroy()
	if not result then
		error("[Space Hub] Key system closed.", 0)
	end
	return true
end

local function discordPrompt(d)
	if not d or not d.Enabled or not d.Invite or d.Invite == "" then
		return
	end
	local folder = "SpaceHub"
	local mark = folder .. "/discord_" .. tostring(d.Invite):gsub("[^%w]", "") .. ".txt"
	if d.RememberJoins ~= false and canFile() then
		local ok, seen = pcall(isfile, mark)
		if ok and seen then
			return
		end
	end
	local gui = createGui("SpaceHubDiscord")
	local modal = makeModal(gui, 340)
	modalText(modal.Card, 1, d.Title or "Join our Discord", 17, TEXT, Enum.Font.GothamBold)
	modalText(modal.Card, 2, d.Content or "Get updates, support and more.", 13, MUTED)
	modalText(modal.Card, 3, "discord.gg/" .. d.Invite, 14, MUTED, Enum.Font.GothamMedium)
	local buttons = buttonRow(modal.Card, 4, { { Text = "Copy invite" }, { Text = "Not now", C1 = GRAY_A, C2 = GRAY_B } })
	local function done(copied)
		modal.Close(function()
			gui:Destroy()
		end)
		if copied and d.RememberJoins ~= false and canFile() then
			pcall(function()
				if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(folder) then
					makefolder(folder)
				end
				writefile(mark, "1")
			end)
		end
	end
	buttons[1].Activated:Connect(function()
		local ok = copyText("https://discord.gg/" .. d.Invite)
		SpaceHub:Notify({ Title = ok and "Invite copied" or "Copy not supported", Content = "discord.gg/" .. d.Invite, Duration = 4 })
		done(ok)
	end)
	buttons[2].Activated:Connect(function()
		done(false)
	end)
end

