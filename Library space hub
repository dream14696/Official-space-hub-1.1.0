local function pickLogo(id, fallback)
	local probe = Instance.new("ImageLabel")
	probe.Image = id
	local ok = false
	pcall(function()
		ContentProvider:PreloadAsync({ probe }, function(_, status)
			ok = (status == Enum.AssetFetchStatus.Success)
		end)
	end)
	probe:Destroy()
	return ok and id or fallback
end

local function showLoading(settings)
	local logoId = pickLogo(settings.LoadingLogo or ASSETS.Logo, ASSETS.LogoFallback)
	local gui = createGui("SpaceHubIntro")
	local vp = workspace.CurrentCamera.ViewportSize
	local side = math.min(450, vp.X * 0.9, vp.Y * 0.9)
	local duration = settings.LoadingDuration or 3
	local fade = math.min(0.8, duration / 3)
	local logo = new("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(side, side),
		BackgroundTransparency = 1, Image = logoId, ScaleType = Enum.ScaleType.Fit, ImageTransparency = 1,
	}, gui)
	tw(logo, fade, { ImageTransparency = 0 }, Enum.EasingStyle.Sine)
	task.wait(duration - fade)
	tw(logo, fade, { ImageTransparency = 1 }, Enum.EasingStyle.Sine)
	task.wait(fade)
	gui:Destroy()
end

