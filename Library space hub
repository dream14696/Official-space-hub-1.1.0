--// ===================== UTILITIES =====================
local function tw(obj, t, props, style, dir)
	local tween = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

local function apply(obj, props, animate, t, style)
	if animate then
		return tw(obj, t or 0.3, props, style)
	end
	for k, v in pairs(props) do
		obj[k] = v
	end
end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function corner(obj, r)
	return new("UICorner", { CornerRadius = typeof(r) == "UDim" and r or UDim.new(0, r) }, obj)
end

local function pad(obj, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top), PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom), PaddingLeft = UDim.new(0, left),
	}, obj)
end

local function themed(obj, prop, key)
	obj[prop] = Theme[key]
	table.insert(themeRegistry, { obj, prop, key })
	return obj
end

local function applyTheme(t)
	Theme = t
	for i = #themeRegistry, 1, -1 do
		local r = themeRegistry[i]
		if r[1].Parent then
			tw(r[1], 0.35, { [r[2]] = t[r[3]] })
		else
			table.remove(themeRegistry, i)
		end
	end
	for _, hook in ipairs(themeHooks) do
		task.spawn(hook)
	end
end

local function setThemeByName(name)
	for _, t in ipairs(THEMES) do
		if t.Name:lower() == tostring(name):lower() then
			applyTheme(t)
			local flag = SpaceHub.Flags["SpaceHub_Theme"]
			if flag then
				flag.CurrentValue = t.Name
			end
			return true
		end
	end
	return false
end

local function bind(signal, fn)
	local c = signal:Connect(fn)
	table.insert(connections, c)
	return c
end

local function canFile()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

local function copyText(txt)
	local f = setclipboard or toclipboard
	if type(f) == "function" then
		return (pcall(f, txt))
	end
	return false
end

local ACCENTS = {
	{ "á", "a" }, { "à", "a" }, { "ä", "a" }, { "â", "a" }, { "Á", "a" }, { "À", "a" }, { "Ä", "a" }, { "Â", "a" },
	{ "é", "e" }, { "è", "e" }, { "ë", "e" }, { "ê", "e" }, { "É", "e" }, { "È", "e" }, { "Ë", "e" }, { "Ê", "e" },
	{ "í", "i" }, { "ì", "i" }, { "ï", "i" }, { "î", "i" }, { "Í", "i" }, { "Ì", "i" }, { "Ï", "i" }, { "Î", "i" },
	{ "ó", "o" }, { "ò", "o" }, { "ö", "o" }, { "ô", "o" }, { "Ó", "o" }, { "Ò", "o" }, { "Ö", "o" }, { "Ô", "o" },
	{ "ú", "u" }, { "ù", "u" }, { "ü", "u" }, { "û", "u" }, { "Ú", "u" }, { "Ù", "u" }, { "Ü", "u" }, { "Û", "u" },
	{ "ñ", "n" }, { "Ñ", "n" }, { "ç", "c" }, { "Ç", "c" },
}
local function normalize(s)
	s = tostring(s)
	for _, p in ipairs(ACCENTS) do
		s = s:gsub(p[1], p[2])
	end
	return (s:lower():gsub("[^%w]", ""))
end

local function safe(fn, ...)
	if type(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[Space Hub] Callback error: " .. tostring(err))
		SpaceHub:Notify({ Title = "Callback error", Content = tostring(err), Duration = 6 })
	end
end

--// Auto-save (debounced)
local saveQueued = false
local function autosave()
	local s = SpaceHub._settings
	if not (s and s.ConfigurationSaving and s.ConfigurationSaving.Enabled) or not SpaceHub.AutoSave then
		return
	end
	if saveQueued then
		return
	end
	saveQueued = true
	task.delay(1, function()
		saveQueued = false
		SpaceHub:SaveConfiguration()
	end)
end

--// Icons: Roblox ID (number / "rbxassetid://") or name from SpaceHub.Icons (Lucide map)
local function applyIcon(img, icon)
	local spec
	if type(icon) == "number" then
		spec = { Image = "rbxassetid://" .. icon }
	elseif type(icon) == "string" and icon ~= "" then
		if icon:find("rbxasset") or icon:find("^https?://") then
			spec = { Image = icon }
		elseif icon:match("^%d+$") then
			spec = { Image = "rbxassetid://" .. icon }
		else
			local v = SpaceHub.Icons[icon:lower()]
			if type(v) == "string" then
				spec = { Image = v }
			elseif type(v) == "number" then
				spec = { Image = "rbxassetid://" .. v }
			elseif type(v) == "table" then
				spec = v
			end
		end
	end
	if not spec then
		return false
	end
	img.Image = spec.Image
	if spec.ImageRectSize then
		img.ImageRectSize = spec.ImageRectSize
	end
	if spec.ImageRectOffset then
		img.ImageRectOffset = spec.ImageRectOffset
	end
	return true
end

-- SpaceHub:SetIcons({ home = "rbxassetid://...", ... }) or SpaceHub:SetIcons("https://.../icons.lua")
function SpaceHub:SetIcons(source)
	local map = source
	if type(source) == "string" then
		local ok, res = pcall(function()
			return loadstring(game:HttpGet(source))()
		end)
		map = ok and res or nil
	end
	if type(map) == "table" then
		for k, v in pairs(map) do
			self.Icons[tostring(k):lower()] = v
		end
	end
end

local function loadImage(obj, id, onFail)
	if not id or id == "" then
		onFail()
		return
	end
	task.spawn(function()
		local ok = false
		pcall(function()
			ContentProvider:PreloadAsync({ obj }, function(_, status)
				ok = (status == Enum.AssetFetchStatus.Success)
			end)
		end)
		if not ok then
			onFail()
		end
	end)
end

--// Metal border (static brushed steel)
local function metalStroke(obj, thickness)
	local s = new("UIStroke", { Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = WHITE }, obj)
	new("UIGradient", {
		Rotation = 35,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C(150, 154, 162)),
			ColorSequenceKeypoint.new(0.2, C(250, 251, 253)),
			ColorSequenceKeypoint.new(0.4, C(122, 126, 136)),
			ColorSequenceKeypoint.new(0.6, C(238, 240, 244)),
			ColorSequenceKeypoint.new(0.8, C(110, 114, 124)),
			ColorSequenceKeypoint.new(1, C(214, 217, 224)),
		}),
	}, s)
	return s
end

local function makeLabel(parent, props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or Enum.Font.Gotham
	props.TextSize = props.TextSize or 13
	props.TextColor3 = props.TextColor3 or TEXT
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return new("TextLabel", props, parent)
end

--// Long metal button
local function makeButton(parent, caption, order, height, c1, c2, left)
	local frame = new("Frame", {
		LayoutOrder = order, Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = WHITE, BorderSizePixel = 0,
	}, parent)
	corner(frame, 8)
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(c1 or STEEL_A, c2 or STEEL_B) }, frame)
	metalStroke(frame, 2)
	local button = new("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, AutoButtonColor = false,
		Text = caption, Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = TEXT,
		TextXAlignment = left and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
	}, frame)
	if left then
		new("UIPadding", { PaddingLeft = UDim.new(0, 14) }, button)
	end
	return frame, button
end

--// Element row (steel background + metal border)
local function row(parent, height, order)
	local frame = new("Frame", {
		LayoutOrder = order or 0, Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = WHITE, BorderSizePixel = 0,
	}, parent)
	corner(frame, 8)
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(STEEL_A, STEEL_B) }, frame)
	metalStroke(frame, 1.5)
	return frame
end

--// Collapsible block (used by Dropdown / ColorPicker / Themes)
local function expandable(parent, order, name, bodyHeight)
	local cont = new("Frame", {
		LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
	}, parent)
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, cont)
	local head = row(cont, 40, 1)
	local nameLbl = makeLabel(head, {
		Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.55, -12, 1, 0),
		Text = name, Font = Enum.Font.GothamMedium, TextSize = 14,
	})
	local arrow = new("ImageLabel", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1, Image = ASSETS.Arrow, ImageColor3 = TEXT, ScaleType = Enum.ScaleType.Fit,
	}, head)
	loadImage(arrow, ASSETS.Arrow, function()
		arrow.Image = ""
		makeLabel(arrow, { Size = UDim2.fromScale(1, 1), Text = "v", Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center })
	end)
	local body = new("Frame", {
		LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, ClipsDescendants = true,
	}, cont)
	local open = false
	local ex = { Container = cont, Head = head, Name = nameLbl, Arrow = arrow, Body = body }
	function ex.SetOpen(v, h)
		open = v
		tw(body, 0.3, { Size = UDim2.new(1, 0, 0, v and (h or bodyHeight) or 0) })
		tw(arrow, 0.3, { Rotation = v and 180 or 0 })
	end
	function ex.IsOpen()
		return open
	end
	local click = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 2 }, head)
	click.Activated:Connect(function()
		ex.SetOpen(not open)
	end)
	return ex
end

