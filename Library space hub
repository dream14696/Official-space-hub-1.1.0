	-- ===== MINIMIZE / MAXIMIZE (from the edges toward the center) =====
	local minimized = false
	local function setMinimized(v)
		minimized = v
		local w, h = W, H
		if v then
			w, h = SIZE.PillW, SIZE.PillH
		end
		local cx = container.Position.X.Offset + container.Size.X.Offset / 2
		local cy = container.Position.Y.Offset + container.Size.Y.Offset / 2
		local p = limit(cx - w / 2, cy - h / 2, w, h)
		tw(container, 0.4, { Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(p.X, p.Y) }, Enum.EasingStyle.Quint)
		local r = v and SIZE.PillH / 2 or 12
		tw(frameCorner, 0.4, { CornerRadius = UDim.new(0, r) })
		for _, s in ipairs(shadows) do
			tw(s.c, 0.4, { CornerRadius = UDim.new(0, r + s.extra) })
		end
		tw(headerLine, 0.3, { BackgroundTransparency = v and 1 or 0 })
		if v then
			tw(controls, 0.15, { GroupTransparency = 1 })
			tw(body, 0.15, { GroupTransparency = 1 }).Completed:Connect(function()
				if minimized then
					body.Visible = false
					controls.Visible = false
				end
			end)
			tw(bar, 0.2, { BackgroundTransparency = 1 }).Completed:Connect(function()
				if minimized then
					grab.Visible = false
				end
			end)
			pillControls.Visible = true
			tw(pillControls, 0.3, { GroupTransparency = 0 })
		else
			grab.Visible = true
			tw(bar, 0.25, { BackgroundTransparency = 0 })
			body.Visible = true
			controls.Visible = true
			tw(controls, 0.25, { GroupTransparency = 0 })
			tw(body, 0.3, { GroupTransparency = 0 })
			tw(pillControls, 0.15, { GroupTransparency = 1 }).Completed:Connect(function()
				if not minimized then
					pillControls.Visible = false
				end
			end)
		end
