local function makeApi(page, tab, register)
	local api = {}
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end
	api._nextOrder = nextOrder

	local function flag(o, obj)
		if o.Flag then
			SpaceHub.Flags[o.Flag] = obj
		end
	end

	-- Section
	function api:CreateSection(name)
		local f = new("Frame", { LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1 }, page)
		local t = makeLabel(f, { Size = UDim2.new(1, 0, 1, -4), Text = name, Font = Enum.Font.GothamBold, TextColor3 = MUTED, TextSize = 12 })
		local line = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0 }, f)
		themed(line, "BackgroundColor3", "Line")
		local obj = { Type = "Section" }
		function obj:Set(n)
			t.Text = n
		end
		return obj
	end

	-- Label
	function api:CreateLabel(txt, icon)
		local f = row(page, 36, nextOrder())
		local x = 12
		if icon then
			local img = new("ImageLabel", { Position = UDim2.fromOffset(10, 9), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, ImageColor3 = WHITE }, f)
			if applyIcon(img, icon) then
				x = 36
			else
				img:Destroy()
			end
		end
		local l = makeLabel(f, { Position = UDim2.fromOffset(x, 0), Size = UDim2.new(1, -x - 12, 1, 0), Text = txt })
		register(txt, "Label", f, tab)
		local obj = { Type = "Label" }
		function obj:Set(t)
			l.Text = t
		end
		return obj
	end

	-- Paragraph
	function api:CreateParagraph(o)
		local f = row(page, 0, nextOrder())
		f.AutomaticSize = Enum.AutomaticSize.Y
		pad(f, 10, 12, 10, 12)
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, f)
		local title = makeLabel(f, {
			LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			Text = o.Title or "", Font = Enum.Font.GothamBold, TextSize = 14, TextWrapped = true,
		})
		local body = makeLabel(f, {
			LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			Text = o.Content or "", TextSize = 12, TextColor3 = MUTED, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
		})
		register(o.Title or "Paragraph", "Paragraph", f, tab)
		local obj = { Type = "Paragraph" }
		function obj:Set(v)
			title.Text = v.Title or title.Text
			body.Text = v.Content or body.Text
		end
		return obj
	end

	-- Button
	function api:CreateButton(o)
		local f = row(page, 40, nextOrder())
		local b = new("TextButton", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, AutoButtonColor = false, Text = o.Name,
			Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = TEXT,
		}, f)
		b.Activated:Connect(function()
			tw(b, 0.08, { TextTransparency = 0.5 }).Completed:Connect(function()
				tw(b, 0.15, { TextTransparency = 0 })
			end)
			safe(o.Callback)
		end)
		register(o.Name, "Button", f, tab)
		local obj = { Type = "Button" }
		function obj:Set(n)
			b.Text = n
		end
		return obj
	end

	-- Toggle
	function api:CreateToggle(o)
		local f = row(page, 40, nextOrder())
		makeLabel(f, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -80, 1, 0), Text = o.Name, Font = Enum.Font.GothamMedium, TextSize = 14 })
		local holder = new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(46, 26), BackgroundTransparency = 1,
		}, f)
		local halo = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 10, 1, 10),
			BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1,
		}, holder)
		corner(halo, UDim.new(1, 0))
		new("UIGradient", {
			Rotation = 35,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, C(255, 255, 255)), ColorSequenceKeypoint.new(0.3, C(70, 245, 140)),
				ColorSequenceKeypoint.new(0.5, C(20, 200, 100)), ColorSequenceKeypoint.new(0.7, C(70, 245, 140)),
				ColorSequenceKeypoint.new(1, C(255, 255, 255)),
			}),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.5, 0.5), NumberSequenceKeypoint.new(1, 0.1),
			}),
		}, halo)
		local track = new("TextButton", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = GRAY, BackgroundTransparency = 0.4,
			AutoButtonColor = false, Text = "", ZIndex = 2,
		}, holder)
		corner(track, UDim.new(1, 0))
		local trackStroke = new("UIStroke", { Thickness = 2, Color = C(150, 150, 150), Transparency = 0.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, track)
		new("UIGradient", {
			Rotation = 35,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, C(255, 255, 255)), ColorSequenceKeypoint.new(0.3, C(90, 255, 160)),
				ColorSequenceKeypoint.new(0.55, C(255, 255, 255)), ColorSequenceKeypoint.new(0.8, C(60, 235, 130)),
				ColorSequenceKeypoint.new(1, C(235, 255, 242)),
			}),
		}, trackStroke)
		local ball = new("Frame", {
			Position = UDim2.new(0, 3, 0.5, -9), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = WHITE, BorderSizePixel = 0,
		}, track)
		corner(ball, UDim.new(1, 0))
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, C(215, 215, 215)) }, ball)
		local glow = new("UIStroke", { Thickness = 4, Color = WHITE, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ball)
		new("UIGradient", {
			Rotation = 45,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, WHITE), ColorSequenceKeypoint.new(0.5, C(190, 255, 215)), ColorSequenceKeypoint.new(1, WHITE),
			}),
		}, glow)

		local obj = { Type = "Toggle", CurrentValue = o.CurrentValue == true, Name = o.Name }
		local function visual(on, animate)
			apply(track, { BackgroundColor3 = on and GREEN or GRAY }, animate, 0.4)
			apply(trackStroke, { Color = on and WHITE or C(150, 150, 150), Transparency = on and 0 or 0.5 }, animate, 0.4)
			apply(halo, { BackgroundTransparency = on and 0.3 or 1 }, animate, 0.4)
			apply(ball, { Position = on and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9) }, animate, 0.35)
			if animate then
				tw(glow, 0.15, { Transparency = 0.15 }).Completed:Connect(function()
					tw(glow, 0.4, { Transparency = on and 0.55 or 1 })
				end)
			else
				glow.Transparency = on and 0.55 or 1
			end
		end
		function obj:Set(v)
			obj.CurrentValue = v == true
			visual(obj.CurrentValue, true)
			safe(o.Callback, obj.CurrentValue)
			autosave()
		end
		track.Activated:Connect(function()
			obj:Set(not obj.CurrentValue)
		end)
		visual(obj.CurrentValue, false)
		register(o.Name, "Toggle", f, tab)
		flag(o, obj)
		return obj
	end

	-- Slider
	function api:CreateSlider(o)
		local min, max = o.Range[1], o.Range[2]
		local inc = o.Increment or 1
		local f = row(page, 54, nextOrder())
		makeLabel(f, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.6, -12, 0, 18), Text = o.Name, Font = Enum.Font.GothamMedium, TextSize = 14 })
		local valLbl = makeLabel(f, {
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 6), Size = UDim2.new(0.4, 0, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = MUTED, TextSize = 12,
		})
		local track = new("Frame", {
			Position = UDim2.new(0, 12, 0, 36), Size = UDim2.new(1, -24, 0, 6), BackgroundColor3 = C(58, 62, 76), BorderSizePixel = 0,
		}, f)
		corner(track, UDim.new(1, 0))
		local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0 }, track)
		themed(fill, "BackgroundColor3", "Accent")
		corner(fill, UDim.new(1, 0))
		local knob = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 2,
		}, track)
		corner(knob, UDim.new(1, 0))
		metalStroke(knob, 1.5)
		local hit = new("TextButton", {
			Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "",
		}, f)

		local obj = { Type = "Slider", CurrentValue = o.CurrentValue or min, Name = o.Name }
		local function round(v)
			v = math.clamp(v, min, max)
			v = math.floor((v - min) / inc + 0.5) * inc + min
			return math.clamp(math.floor(v * 10000 + 0.5) / 10000, min, max)
		end
		local function visual(v)
			local p = (max == min) and 0 or (v - min) / (max - min)
			fill.Size = UDim2.new(p, 0, 1, 0)
			knob.Position = UDim2.new(p, 0, 0.5, 0)
			valLbl.Text = tostring(v) .. (o.Suffix and (" " .. o.Suffix) or "")
		end
		obj.CurrentValue = round(obj.CurrentValue)
		visual(obj.CurrentValue)

		local dragging = false
		local function update(x)
			local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			local v = round(min + rel * (max - min))
			if v ~= obj.CurrentValue then
				obj.CurrentValue = v
				visual(v)
				safe(o.Callback, v)
				autosave()
			end
		end
		hit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				page.ScrollingEnabled = false
				update(input.Position.X)
			end
		end)
		bind(UserInputService.InputChanged, function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				update(input.Position.X)
			end
		end)
		bind(UserInputService.InputEnded, function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				dragging = false
				page.ScrollingEnabled = true
			end
		end)
		function obj:Set(v)
			obj.CurrentValue = round(tonumber(v) or min)
			visual(obj.CurrentValue)
			safe(o.Callback, obj.CurrentValue)
			autosave()
		end
		register(o.Name, "Slider", f, tab)
		flag(o, obj)
		return obj
	end

	-- Dropdown (single or multiple selection)
	function api:CreateDropdown(o)
		local options = o.Options or {}
		local multiple = o.MultipleOptions == true
		local ex = expandable(page, nextOrder(), o.Name, 0)
		local valueLbl = makeLabel(ex.Head, {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -38, 0.5, 0), Size = UDim2.new(0.4, 0, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = MUTED, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd,
		})
		local list = new("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
		}, ex.Body)
		themed(list, "ScrollBarImageColor3", "Accent")
		new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, list)
		pad(list, 3, 8, 3, 3)

		local selected = {}
		local buttons = {}
		local obj = { Type = "Dropdown", CurrentOption = {}, Name = o.Name }
		local function ordered()
			local r = {}
			for _, opt in ipairs(options) do
				if selected[opt] then
					table.insert(r, opt)
				end
			end
			return r
		end
		local function paint()
			for opt, b in pairs(buttons) do
				b.TextColor3 = selected[opt] and Theme.Accent or TEXT
			end
			local cur = ordered()
			valueLbl.Text = #cur > 0 and table.concat(cur, ", ") or "None"
		end
		local function commit(silent)
			obj.CurrentOption = ordered()
			paint()
			if not silent then
				safe(o.Callback, obj.CurrentOption)
				autosave()
			end
		end
		local function build()
			for _, b in pairs(buttons) do
				b.Parent:Destroy()
			end
			buttons = {}
			for i, opt in ipairs(options) do
				local _, b = makeButton(list, tostring(opt), i, 30)
				buttons[opt] = b
				b.Activated:Connect(function()
					if multiple then
						selected[opt] = not selected[opt] or nil
					else
						selected = { [opt] = true }
						ex.SetOpen(false)
					end
					commit(false)
				end)
			end
			local h = math.min(#options * 36 + 8, 182)
			if ex.IsOpen() then
				ex.SetOpen(true, h)
			end
			ex.Height = h
			paint()
		end
		local origSetOpen = ex.SetOpen
		ex.SetOpen = function(v, h)
			origSetOpen(v, h or ex.Height)
		end

		local initial = o.CurrentOption or {}
		if type(initial) == "string" then
			initial = { initial }
		end
		for _, v in ipairs(initial) do
			selected[v] = true
		end
		build()
		commit(true)

		function obj:Set(v)
			selected = {}
			if type(v) == "string" then
				v = { v }
			end
			for _, x in ipairs(v or {}) do
				selected[x] = true
			end
			commit(false)
		end
		function obj:Refresh(newOptions)
			options = newOptions or {}
			for k in pairs(selected) do
				if not table.find(options, k) then
					selected[k] = nil
				end
			end
			build()
			commit(true)
		end
		table.insert(themeHooks, paint)
		register(o.Name, "Dropdown", ex.Head, tab)
		flag(o, obj)
		return obj
	end

